<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="5dp" android:background="@drawable/nona_widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Нона" android:gravity="center" android:textColor="#FBF0D9"
        android:textSize="16sp" android:textStyle="bold" />
    <ImageView android:id="@+id/widget_flag" android:layout_width="18dp"
        android:layout_height="13dp" android:layout_marginTop="7dp"
        android:contentDescription="Флаг страны сервера" />
    <ImageView android:id="@+id/widget_toggle" android:layout_width="56dp"
        android:layout_height="42dp" android:layout_marginTop="5dp"
        android:scaleType="fitCenter" android:contentDescription="Переключить VPN" />
    <TextView android:id="@+id/widget_ping_value" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
        android:textColor="#FBF0D9" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_ping" android:layout_width="58dp"
        android:layout_height="35dp" android:gravity="center" android:text="ПИНГ"
        android:textColor="#FBF0D9" android:textSize="11sp" android:textStyle="bold"
        android:background="@drawable/nona_widget_ping_button"
        android:contentDescription="Проверить пинг" />
</LinearLayout>
