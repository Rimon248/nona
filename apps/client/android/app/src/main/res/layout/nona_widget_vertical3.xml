<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:padding="5dp" android:background="@drawable/nona_widget_background">
    <ImageView android:id="@+id/widget_toggle" android:layout_width="56dp"
        android:layout_height="42dp" android:layout_gravity="end"
        android:scaleType="fitCenter" android:contentDescription="Переключить VPN" />
    <TextView android:id="@+id/widget_ping" android:layout_width="58dp"
        android:layout_height="35dp" android:layout_gravity="end" android:gravity="center"
        android:text="ПИНГ" android:textColor="#FBF0D9" android:textSize="11sp"
        android:textStyle="bold" android:background="@drawable/nona_widget_ping_button"
        android:contentDescription="Проверить пинг" />
    <LinearLayout android:layout_width="1dp" android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView android:id="@+id/widget_country" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
        android:ellipsize="end" android:textColor="#FBF0D9" android:textSize="11sp" />
    <TextView android:id="@+id/widget_ping_value" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
        android:textColor="#FBF0D9" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
