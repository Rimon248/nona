<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:padding="9dp" android:background="@drawable/nona_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center">
        <ImageView android:id="@+id/widget_flag" android:layout_width="20dp"
            android:layout_height="15dp" android:layout_marginEnd="6dp"
            android:contentDescription="Флаг страны сервера" />
        <TextView android:id="@+id/widget_country" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:textColor="#FBF0D9" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
        android:textColor="#A9BEC9" android:textSize="14sp" />
    <TextView android:id="@+id/widget_ping_value" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:maxLines="1"
        android:layout_marginTop="8dp" android:textColor="#FBF0D9"
        android:textSize="18sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="1dp" android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center">
        <ImageView android:id="@+id/widget_toggle" android:layout_width="96dp"
            android:layout_height="72dp" android:scaleType="fitCenter"
            android:contentDescription="Переключить VPN" />
        <TextView android:id="@+id/widget_ping" android:layout_width="100dp"
            android:layout_height="62dp" android:layout_marginStart="12dp" android:gravity="center" android:text="ПИНГ"
            android:textColor="#FBF0D9" android:textSize="12sp" android:textStyle="bold"
            android:background="@drawable/nona_widget_ping_button"
            android:contentDescription="Проверить пинг" />
    </LinearLayout>
</LinearLayout>
